# Copie este arquivo para ".env" (na pasta backend) e preencha com seus dados.
# O arquivo .env NÃO é versionado (está no .gitignore).

# Connection string do MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=pokedex

# Nome do banco de dados
MONGODB_DATABASE=pokedex

# Opcional: origens liberadas no CORS (frontend)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opcional: true para apagar e recarregar os dados do Script_Pokedex.sql ao iniciar
# SEED_RESET=false
